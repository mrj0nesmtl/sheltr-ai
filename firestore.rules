rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =================================================================
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL
    // =================================================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user role from custom claims only (to avoid circular dependencies)
    function getUserRole() {
      return request.auth.token.role;
    }
    
    // Get user shelter_id from custom claims only (to avoid circular dependencies)
    function getUserShelterId() {
      return request.auth.token.shelter_id;
    }
    
    // Simplified role check for admins - checks if the user document exists and matches
    function canAccessShelterData(shelterId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        isPlatformAdmin() ||
        isAdmin()
      );
    }
    
    // Check user roles using custom claims first
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }
    
    function isPlatformAdmin() {
      return isAuthenticated() && getUserRole() == 'platform_admin';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isParticipant() {
      return isAuthenticated() && getUserRole() == 'participant';
    }
    
    function isDonor() {
      return isAuthenticated() && getUserRole() == 'donor';
    }
    
    // Check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if admin manages this shelter
    function canManageShelter(shelterId) {
      return isSuperAdmin() || 
             isPlatformAdmin() ||
             (isAdmin() && getUserShelterId() == shelterId);
    }
    
    // =================================================================
    // USERS COLLECTION - Core user profiles
    // =================================================================
    match /users/{userId} {
      // Read: Users can read their own profile, admins can read all authenticated
      allow read: if isOwner(userId) || 
                     isSuperAdmin() ||
                     isPlatformAdmin() ||
                     isAdmin();
      
      // Write: Users can update their own profile, admins can update
      allow write: if isOwner(userId) || 
                      isSuperAdmin() ||
                      isPlatformAdmin() ||
                      isAdmin();
      
      // Create: Anyone authenticated can create their own user profile
      allow create: if isAuthenticated() && isOwner(userId);
      
      // List/Query: Allow all admins to query users
      allow list: if isSuperAdmin() || 
                     isPlatformAdmin() ||
                     isAdmin();
    }
    
    // =================================================================
    // TENANTS COLLECTION - Multi-tenant platform structure
    // =================================================================
    match /tenants/{tenantId} {
      // Read: Super admin, platform admin, and shelter admins can read tenants
      allow read: if isSuperAdmin() || isPlatformAdmin() || isAdmin();
      
      // Write: Super admin and platform admin can write all tenants
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super admin and platform admin can create tenants
      allow create: if isSuperAdmin() || isPlatformAdmin();
    }
    
    // Tenant sub-collections (platform data, shelters, etc.)
    match /tenants/{tenantId}/{document=**} {
      // Read: Super admin, platform admin, and shelter admins can read tenant data
      allow read: if isSuperAdmin() || isPlatformAdmin() || isAdmin();
      
      // Write: Super admin and platform admin can write tenant data
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super admin and platform admin can create tenant data
      allow create: if isSuperAdmin() || isPlatformAdmin();
    }
    
    // =================================================================
    // SHELTERS COLLECTION - Shelter information and management
    // =================================================================
    match /shelters/{shelterId} {
      // Read: Public access allowed for shelter showcase, authenticated users can read all
      allow read: if true;
      
      // Write: Super admin and platform admin can write all, admins can write their own shelter
      allow write: if isSuperAdmin() || isPlatformAdmin() || canManageShelter(shelterId);
      
      // List/Query: All authenticated users can list shelters
      allow list: if isAuthenticated();
    }
    
    // =================================================================
    // PARTICIPANTS COLLECTION - Participant profiles and data
    // =================================================================
    match /participants/{participantId} {
      // Read: Public access allowed for participant showcase pages (demo participants)
      allow read: if true;
      
      // Write: Owner, admins, super admin
      allow write: if isOwner(participantId) || isSuperAdmin() || isAdmin();
      
      // Create: Authenticated users can create participant profiles
      allow create: if isAuthenticated();
    }
    
    // =================================================================
    // DONATIONS COLLECTION - Donation records and tracking
    // =================================================================
    match /donations/{donationId} {
      // Read: Donors can read their own donations, participants can read donations to them, 
      // admins can read donations, super admin can read all
      allow read: if isSuperAdmin() ||
                     (isDonor() && resource.data.donor_id == request.auth.uid) ||
                     (isParticipant() && resource.data.participant_id == request.auth.uid) ||
                     isAdmin();
      
      // Write: System creates donations (via backend), super admin can modify
      allow write: if isSuperAdmin();
      
      // Create: Authenticated users can create donations (validated by backend)
      allow create: if isAuthenticated();
    }
    
    // =================================================================
    // DEMO_DONATIONS COLLECTION - Demo/test donation records
    // =================================================================
    match /demo_donations/{donationId} {
      // Read: Public access allowed for participant showcase pages and demo functionality
      allow read: if true;
      
      // Write: Super admin can modify demo donations
      allow write: if isSuperAdmin();
      
      // Create: Anyone can create demo donations for testing (including anonymous users)
      allow create: if true;
    }
    
    // =================================================================
    // QR_CODES COLLECTION - QR code management
    // =================================================================
    match /qr_codes/{qrCodeId} {
      // Read: Owner, admins, super admin
      allow read: if isOwner(resource.data.participant_id) || isSuperAdmin() || isAdmin();
      
      // Write: Owner, admins, super admin
      allow write: if isOwner(resource.data.participant_id) || isSuperAdmin() || isAdmin();
      
      // Create: Participants can create their own QR codes
      allow create: if isAuthenticated();
    }
    
    // =================================================================
    // ANALYTICS COLLECTION - Platform analytics and insights
    // =================================================================
    match /analytics/{analyticsId} {
      // Read: Admins can read analytics, super admin can read all
      allow read: if isSuperAdmin() || isAdmin();
      
      // Write: Super admin only (analytics generated by system)
      allow write: if isSuperAdmin();
    }
    
    // =================================================================
    // SERVICES COLLECTION - Available services and resources
    // =================================================================
    match /services/{serviceId} {
      // Read: All authenticated users can read services
      allow read: if isAuthenticated();
      
      // Write: Admins can write services, super admin can write all
      allow write: if isSuperAdmin() || isAdmin();
      
      // Create: Admins can create services
      allow create: if isAdmin() || isSuperAdmin();
      
      // List/Query: All authenticated users can query services
      allow list: if isAuthenticated();
    }

    // =================================================================
    // APPOINTMENTS COLLECTION - Appointments and bookings
    // =================================================================
    match /appointments/{appointmentId} {
      // Read: All authenticated users can read appointments
      allow read: if isAuthenticated();
      
      // Write: Admins can write appointments, participants can write their own
      allow write: if isSuperAdmin() ||
                      isPlatformAdmin() ||
                      isAdmin() ||
                      (isParticipant() && resource.data.participant_id == request.auth.uid);
      
      // Create: All authenticated users can create appointments
      allow create: if isAuthenticated();
      
      // List/Query: All authenticated users can query appointments
      allow list: if isAuthenticated();
    }
    
    // =================================================================
    // KNOWLEDGE_BASE COLLECTION - AI chatbot knowledge base (legacy)
    // =================================================================
    match /knowledge_base/{docId} {
      // Read: All authenticated users can read public knowledge
      allow read: if isAuthenticated();
      
      // Write: Super admin only
      allow write: if isSuperAdmin();
    }
    
    // =================================================================
    // KNOWLEDGE DOCUMENTS COLLECTION - New knowledge base documents
    // =================================================================
    match /knowledge_documents/{docId} {
      // Read: All authenticated users can read published documents
      allow read: if isAuthenticated();
      
      // Write: Super Admin only
      allow write: if isSuperAdmin();
      
      // Create: Super Admin only
      allow create: if isSuperAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // KNOWLEDGE CHUNKS COLLECTION - Document chunks for embeddings
    // =================================================================
    match /knowledge_chunks/{chunkId} {
      // Read: System access only (for AI processing)
      allow read: if isSuperAdmin();
      
      // Write: Super Admin only (system processing)
      allow write: if isSuperAdmin();
      
      // Create: Super Admin only (system processing)
      allow create: if isSuperAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // PLATFORM CONFIGURATION - System settings and configuration
    // =================================================================
    match /platform_config/{configId} {
      // Read: Super Admin and Platform Admin
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin only
      allow write: if isSuperAdmin();
      
      // Create: Super Admin only
      allow create: if isSuperAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // ADMIN PROFILES - Super admin profile information
    // =================================================================
    match /admin_profiles/{userId} {
      // Read/Write: Super Admin and Platform Admin can access their own profile
      allow read, write: if (isSuperAdmin() || isPlatformAdmin()) && request.auth.uid == userId;
      
      // Create: Super Admin and Platform Admin can create their own profile
      allow create: if (isSuperAdmin() || isPlatformAdmin()) && request.auth.uid == userId;
    }
    
    // =================================================================
    // AUDIT LOGS - System change tracking
    // =================================================================
    match /audit_logs/{logId} {
      // Read: Super Admin and Platform Admin
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin (for logging changes)
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super Admin and Platform Admin
      allow create: if isSuperAdmin() || isPlatformAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }

    
    // =================================================================
    // CHAT_SESSIONS COLLECTION - Chatbot conversation history
    // =================================================================
    match /chat_sessions/{sessionId} {
      // Read: Owner, super admin
      allow read: if isOwner(resource.data.user_id) || isSuperAdmin();
      
      // Write: Owner, super admin
      allow write: if isOwner(resource.data.user_id) || isSuperAdmin();
      
      // Create: Authenticated users can create their own chat sessions
      allow create: if isAuthenticated();
    }
    
    // =================================================================
    // SYSTEM CONFIGURATION - Platform-wide settings
    // =================================================================
    match /system/{configId} {
      // Read: Super admin only
      allow read: if isSuperAdmin();
      
      // Write: Super admin only
      allow write: if isSuperAdmin();
    }
    
    // =================================================================
    // AUDIT_LOGS COLLECTION - Security and audit logging
    // =================================================================
    match /audit_logs/{logId} {
      // Read: Super admin only
      allow read: if isSuperAdmin();
      
      // Write: System only (no client writes)
      allow write: if false;
      
      // Create: System only
      allow create: if false;
    }
    
    // =================================================================
    // PARTICIPANT SUB-COLLECTIONS
    // =================================================================
    
    // Participant services history
    match /participants/{participantId}/services/{serviceId} {
      allow read, write: if isOwner(participantId) || isSuperAdmin() || isAdmin();
    }
    
    // Participant donation history
    match /participants/{participantId}/donations/{donationId} {
      allow read: if isOwner(participantId) || isSuperAdmin() || isAdmin();
      allow write: if false; // Donations created by system only
    }
    
    // =================================================================
    // SHELTER SUB-COLLECTIONS
    // =================================================================
    
    // Shelter staff
    match /shelters/{shelterId}/staff/{staffId} {
      allow read, write: if canManageShelter(shelterId);
    }
    
    // Shelter services
    match /shelters/{shelterId}/services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if canManageShelter(shelterId);
    }
    
    // Shelter analytics
    match /shelters/{shelterId}/analytics/{analyticsId} {
      allow read: if canManageShelter(shelterId);
      allow write: if isSuperAdmin();
    }
    
    // Shelter public configurations (for public pages)
    match /shelters/{shelterId}/public_config/{configId} {
      // Read: Public access allowed for public shelter pages
      allow read: if true;
      // Write: Only shelter admins and higher can modify
      allow write: if canManageShelter(shelterId);
    }
    
    // =================================================================
    // PLATFORM MANAGEMENT COLLECTIONS
    // =================================================================
    
    // Feature flags - Super Admin can manage, all authenticated users can read
    match /feature_flags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // System alerts - Super Admin can manage, all authenticated users can read
    match /system_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Platform metrics - Super Admin can manage, all authenticated users can read
    match /platform_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Newsletter signups - Super Admin can manage, all authenticated users can read, anyone can create
    match /newsletter_signups/{signupId} {
      allow read: if isAuthenticated();
      allow create: if true; // Allow anyone to sign up for newsletter
      allow update, delete: if isSuperAdmin();
    }
    
    // =================================================================
    // BLOG COLLECTIONS - Blog post management
    // =================================================================
    
    // Blog posts - Super Admin can manage, all authenticated users can read published posts
    match /blog_posts/{postId} {
      allow read: if isAuthenticated() && (resource.data.status == 'published' || isSuperAdmin());
      allow write: if isSuperAdmin();
    }
    
    // Blog categories - Super Admin can manage, all authenticated users can read
    match /blog_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Blog tags - Super Admin can manage, all authenticated users can read
    match /blog_tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
        // =================================================================
    // PARTICIPANT PROFILES COLLECTION - Profile data and privacy settings
    // =================================================================
    match /participant_profiles/{participantId} {
      // Read: Public access allowed for participant showcase pages, profile owner, their shelter admin, super admin
      allow read: if true;

      // Write: Profile owner, their shelter admin, super admin
      allow write: if isAuthenticated() && (
        participantId == request.auth.uid ||
        isSuperAdmin() ||
        isAdmin()
      );

      // Create: Participants can create their own profile, admins can create for their participants
      allow create: if isAuthenticated() && (
        participantId == request.auth.uid ||
        isSuperAdmin() ||
        isAdmin()
      );

      // Delete: Profile owner, super admin
      allow delete: if isAuthenticated() && (
        participantId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // =================================================================
    // PARTICIPANT GOALS COLLECTION - Goal tracking and management
    // =================================================================
    match /participant_goals/{goalId} {
      // Read: Goal owner, their shelter admin, super admin
      allow read: if isAuthenticated() && (
        resource.data.participantId == request.auth.uid ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.assignedCaseWorker == request.auth.uid)
      );

      // Write: Goal owner, their shelter admin, super admin
      allow write: if isAuthenticated() && (
        resource.data.participantId == request.auth.uid ||
        isSuperAdmin() ||
        (isAdmin() && resource.data.assignedCaseWorker == request.auth.uid)
      );

      // Create: Participants can create their own goals, admins can create for their participants
      allow create: if isAuthenticated() && (
        request.resource.data.participantId == request.auth.uid ||
        isSuperAdmin() ||
        isAdmin()
      );

      // Delete: Goal owner, super admin
      allow delete: if isAuthenticated() && (
        resource.data.participantId == request.auth.uid ||
        isSuperAdmin()
      );
    }
    
    // =================================================================
    // CHATBOT COLLECTIONS - Chat sessions and messages
    // =================================================================
    
    // Chat sessions - Users can manage their own sessions, Super Admin can read all
    match /chat_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow write: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }
    
    // Chat messages - Users can manage messages in their sessions, Super Admin can read all
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated() && (
        get(/databases/$(database.name)/documents/chat_sessions/$(resource.data.session_id)).data.user_id == request.auth.uid || 
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        get(/databases/$(database.name)/documents/chat_sessions/$(request.resource.data.session_id)).data.user_id == request.auth.uid || 
        isSuperAdmin()
      );
    }
    
    // Agent configurations - Super Admin can manage, all authenticated users can read
    match /agent_configurations/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }
    
    // Contact inquiries - Anyone can create, Super Admin can read/update
    match /contact_inquiries/{inquiryId} {
      allow create: if true; // Anyone can submit contact forms
      allow read, update: if isSuperAdmin() || isPlatformAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // FRAUD ALERTS COLLECTION - Fraud detection and security alerts
    // =================================================================
    match /fraud_alerts/{alertId} {
      // Read: Super Admin and Platform Admin can read all fraud alerts
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin can update fraud alerts
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: System can create fraud alerts (authenticated users for testing)
      allow create: if isAuthenticated();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // ADMIN NOTIFICATIONS COLLECTION - Administrative notifications
    // =================================================================
    match /admin_notifications/{notificationId} {
      // Read: Super Admin and Platform Admin can read all notifications
      // Shelter Admins can read their own notifications
      allow read: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.recipient_id == request.auth.uid));
      
      // Write: Admins can update their own notifications (mark as read)
      allow write: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.recipient_id == request.auth.uid));
      
      // Create: Any authenticated admin can create notifications
      allow create: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
      
      // List/Query: Super Admin and Platform Admin can query all
      allow list: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin());
    }
    
    // =================================================================
    // SHELTER EMAIL SIGNUPS COLLECTION - Shelter-specific email captures
    // =================================================================
    match /shelter_email_signups/{signupId} {
      // Read: Super Admin and Platform Admin can read all, Shelter Admins can read their own shelter's signups
      allow read: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.shelter_id == getUserShelterId()));
      
      // Create: Public can create signups (for public shelter page forms)
      allow create: if request.resource.data.keys().hasAll(['email', 'shelter_id']);
      
      // Update: Admins can update status (mark as contacted, unsubscribed, etc.)
      allow update: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.shelter_id == getUserShelterId()));
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
      
      // List/Query: Super Admin and Platform Admin can query all
      allow list: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin());
    }
    
    // =================================================================
    // SHELTER CONTACT INQUIRIES COLLECTION - Shelter-specific contact forms
    // =================================================================
    match /shelter_contact_inquiries/{inquiryId} {
      // Read: Super Admin and Platform Admin can read all, Shelter Admins can read their own shelter's inquiries
      allow read: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.shelter_id == getUserShelterId()));
      
      // Create: Public can create inquiries (for public shelter page contact forms)
      allow create: if request.resource.data.keys().hasAll(['shelter_id', 'sender_email', 'message']);
      
      // Update: Admins can update inquiries (respond, mark as resolved, etc.)
      allow update: if isAuthenticated() && 
        (isSuperAdmin() || isPlatformAdmin() || 
         (isAdmin() && resource.data.shelter_id == getUserShelterId()));
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
      
      // List/Query: Super Admin and Platform Admin can query all
      allow list: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin());
    }
    
    // =================================================================
    // GALLERY IMAGES COLLECTION - Public gallery management
    // =================================================================
    match /gallery_images/{imageId} {
      // Read: Anyone can read public images, admins can read all
      allow read: if resource.data.isPublic == true || isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin can manage gallery
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super Admin and Platform Admin can upload images
      allow create: if isSuperAdmin() || isPlatformAdmin();
      
      // Delete: Super Admin and Platform Admin can delete images
      allow delete: if isSuperAdmin() || isPlatformAdmin();
    }
    
    // =================================================================
    // NDA AGREEMENTS COLLECTION - Digital signature agreements for Platform Administrators
    // =================================================================
    match /nda_agreements/{userId} {
      // Read: Super Admin can read all NDAs, Platform Admins can read their own
      allow read: if isSuperAdmin() || (isPlatformAdmin() && userId == request.auth.uid);
      
      // Write: Platform Admins can sign their own NDA, Super Admin can manage all
      allow write: if isSuperAdmin() || (isPlatformAdmin() && userId == request.auth.uid);
      
      // Create: Platform Admins can create their own NDA signature
      allow create: if isPlatformAdmin() && userId == request.auth.uid;
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // USER_STATUS COLLECTION - Real-time user online/offline status
    // =================================================================
    match /user_status/{userId} {
      // Read: Users can read their own status, all authenticated users can read others' status
      allow read: if isAuthenticated();
      
      // Write: Users can only update their own status
      allow write: if isAuthenticated() && isOwner(userId);
      
      // Create: Users can create their own status document
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Delete: Users can delete their own status, Super Admin can delete any
      allow delete: if isAuthenticated() && (isOwner(userId) || isSuperAdmin());
    }
    
    // =================================================================
    // INTERNAL MESSAGING SYSTEM COLLECTIONS
    // =================================================================
    
    // User shortcodes - Admin users can manage shortcodes for messaging
    match /user_shortcodes/{shortcodeId} {
      // Read: All admin users can read shortcodes for messaging
      allow read: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Write: Admin users can update their own shortcode, Super Admin can update all
      allow write: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource.data.userId == request.auth.uid && (isPlatformAdmin() || isAdmin()))
      );
      
      // Create: Admin users can create shortcodes
      allow create: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Internal messages - Admin-to-admin messaging
    match /internal_messages/{messageId} {
      // Read: Message participants and Super Admin can read messages
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      
      // Write: Message participants can update (mark as read), Super Admin can manage all
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      
      // Create: Admin users can create messages
      allow create: if isAuthenticated() && (
        isSuperAdmin() || isPlatformAdmin() || isAdmin()
      ) && request.resource.data.fromUserId == request.auth.uid;
      
      // Delete: Super Admin only (soft delete via isDeleted field)
      allow delete: if isSuperAdmin();
    }
    
    // Message conversations - Conversation management
    match /message_conversations/{conversationId} {
      // Read: Conversation participants and Super Admin can read
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid in resource.data.participantIds
      );
      
      // Write: Conversation participants can update, Super Admin can manage all
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.uid in resource.data.participantIds
      );
      
      // Create: Admin users can create conversations
      allow create: if isAuthenticated() && (
        isSuperAdmin() || isPlatformAdmin() || isAdmin()
      ) && request.auth.uid in request.resource.data.participantIds;
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Automation workflows - MCP and email automation
    match /automation_workflows/{workflowId} {
      // Read: Super Admin and Platform Admin can read automation workflows
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin can manage workflows
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super Admin and Platform Admin can create workflows
      allow create: if isSuperAdmin() || isPlatformAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Email templates - Template management for automation
    match /email_templates/{templateId} {
      // Read: Super Admin and Platform Admin can read templates
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin can manage templates
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: Super Admin and Platform Admin can create templates
      allow create: if isSuperAdmin() || isPlatformAdmin();
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // MCP activity log - Chatbot integration activity tracking
    match /mcp_activity_log/{activityId} {
      // Read: Super Admin and Platform Admin can read MCP logs
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: System can log MCP activity (authenticated users for integration)
      allow write: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Create: System can create MCP activity logs
      allow create: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Inquiry tracking - Contact form and inquiry management
    match /inquiry_tracking/{inquiryId} {
      // Read: Super Admin and Platform Admin can read inquiries
      allow read: if isSuperAdmin() || isPlatformAdmin();
      
      // Write: Super Admin and Platform Admin can manage inquiries
      allow write: if isSuperAdmin() || isPlatformAdmin();
      
      // Create: System can create inquiry tracking (anyone can submit contact forms)
      allow create: if true;
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Message notifications - User notification system
    match /message_notifications/{notificationId} {
      // Read: Users can read their own notifications, Super Admin can read all
      // Allow queries even when no documents exist
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid || isSuperAdmin());
      
      // Write: Users can update their own notifications (mark as read)
      allow write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Create: System can create notifications for admin users
      allow create: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin() || isAdmin());
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // Contact inquiries - Contact form submissions
    match /contact_inquiries/{inquiryId} {
      // Read: Super Admin and Platform Admin can read contact inquiries
      allow read: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin());
      
      // Write: Super Admin and Platform Admin can update inquiries (mark as read)
      allow write: if isAuthenticated() && (isSuperAdmin() || isPlatformAdmin());
      
      // Create: Anyone can create contact inquiries (public contact forms)
      allow create: if true;
      
      // Delete: Super Admin only
      allow delete: if isSuperAdmin();
    }
    
    // =================================================================
    // SECURE DOCUMENT COLLECTIONS - Founders and Platform Admin sensitive documents
    // =================================================================
    
    // Check if user is an authorized founder (by email)
    function isAuthorizedFounder() {
      return isAuthenticated() && request.auth.token.email in [
        'joel.yaffe@gmail.com',
        'alexanderkline13@gmail.com', 
        'alaghetts@gmail.com',
        'doug.kukura@gmail.com',
        'morganhirtle@gmail.com'
      ];
    }
    
    // Founder documents - Business plans, strategic documents, confidential materials
    match /founder_documents/{documentId} {
      // Read: Only authorized founders can read founder documents
      allow read: if isAuthorizedFounder();
      
      // Write: Only authorized founders can update founder documents
      allow write: if isAuthorizedFounder();
      
      // Create: Only authorized founders can create founder documents
      allow create: if isAuthorizedFounder();
      
      // Delete: Only authorized founders can delete founder documents
      allow delete: if isAuthorizedFounder();
    }
    
    // Platform admin documents - Welcome letters, internal documentation, training materials
    match /platform_admin_documents/{documentId} {
      // Read: Super Admin, Platform Admin, and authorized founders can read
      allow read: if isSuperAdmin() || isPlatformAdmin() || isAuthorizedFounder();
      
      // Write: Super Admin and authorized founders can update documents
      allow write: if isSuperAdmin() || isAuthorizedFounder();
      
      // Create: Super Admin and authorized founders can create documents
      allow create: if isSuperAdmin() || isAuthorizedFounder();
      
      // Delete: Super Admin and authorized founders can delete documents
      allow delete: if isSuperAdmin() || isAuthorizedFounder();
    }
    
    // =================================================================
    // FALLBACK RULE - Deny all other access
    // =================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}